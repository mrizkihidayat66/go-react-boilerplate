# Copy to .env for local development. Everything here has a working
# default except where noted; production deployments should use real
# environment variables (see docs/deployment.md).

# development | production | test
APP_ENV=development
APP_NAME=go-react-boilerplate

# HTTP server
HOST=
PORT=8080
# Public origin, used for absolute URLs. Set when behind a proxy.
BASE_URL=http://localhost:8080

# Database: sqlite (default) or postgres
DB_DRIVER=sqlite
# SQLite file path (created automatically)
DB_PATH=data/app.db
# Postgres DSN (required when DB_DRIVER=postgres)
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=required
# Connection pool sizes. SQLite wants few writers.
DB_MAX_OPEN=5
DB_MAX_IDLE=5
# Run embedded migrations on boot (leave on unless you migrate manually)
DB_AUTO_MIGRATE=true

# Auth
# Required in production, >= 32 chars. Generate: openssl rand -hex 32
SESSION_SECRET=
# Session lifetime as a Go duration (rolling — renewed on activity)
# SESSION_TTL=24h

# Override the Secure attribute on auth cookies. Unset = derived from
# APP_ENV (true in production, false otherwise), which is correct when
# browsers reach the app over HTTPS (directly or via a TLS proxy).
# Set to false ONLY to review a production build over plain HTTP — e.g. a
# local VM at an IP address, where browsers reject Secure cookies.
# COOKIE_SECURE=false

# Requests per minute per IP on auth endpoints (login/register/logout)
AUTH_RATE_LIMIT=10

# Comma-separated CIDR/IP list of reverse proxies whose X-Forwarded-For
# header is trusted for rate limiting. Leave EMPTY when not behind a
# proxy (the header is spoofable). Example behind nginx on localhost:
# TRUSTED_PROXIES=127.0.0.1/32
TRUSTED_PROXIES=

# Allowed origins for CORS (comma-separated). Leave empty when the SPA
# is embedded (default) or proxied by Vite. Set to your origin when
# hosting the SPA separately from the API.
# CORS_ORIGINS=https://app.example.com

# Logging: debug | info | warn | error; LOG_JSON=true emits JSON lines
LOG_LEVEL=info
LOG_JSON=false
